# ==============================================================================
# Supabase Configuration
# ==============================================================================
# Your Supabase Project URL (found in Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Anonymous / Publishable Key (safe for browser client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Optional: Supabase Service Role Secret Key (Server-only / Vercel env var)
# Highly recommended for server API routes to bypass RLS restrictions safely.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# ==============================================================================
# Workshop Registration Settings
# ==============================================================================
# Total capacity of registrations permitted
REGISTRATION_CAP=100

# Target number of attendees to shortlist
SHORTLIST_CAP=40
